# Settings for your own copy of the site: copy this file to .env (never
# committed). All are optional; `npm run build` and `npm run dev` read them.

# Visitor statistics with Umami (https://umami.is): off unless the first three
# are set correctly. The disclaimer page then says what's collected.
#   UMAMI_SCRIPT_URL=https://stats.example.org/script.js
#   UMAMI_DOMAINS=music.example.org   (the host names to count, comma-separated)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=
# Also record visits as replays, e.g. https://stats.example.org/recorder.js
UMAMI_RECORDER_URL=

# A link to the source code on every page
SOURCE_URL=
