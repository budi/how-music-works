{{!--
  A sung exercise: a pattern of scale degrees, played on a loop with a ladder
  that shows each jump (js/pages/note-distance/exercise.js does the drawing and playing).

    {{> interval-exercise name="Leaps up from do" pattern="1 2 1 3 1 4" tempo=72}}

  name      title above it
  note      a line of explanation under the title (optional)
  pattern   degrees 1-8, 1 = do, 8 = the do an octave up
  group     notes per group (default 2): the jump is shown within a group,
            and "Gap to sing it back" leaves room after each one
  tempo     beats per minute to start at
--}}
<figure class="interval-ex" data-pattern="{{pattern}}"{{#if group}} data-group="{{group}}"{{/if}}{{#if tempo}} data-tempo="{{tempo}}"{{/if}}>
  <figcaption><b>{{name}}</b>{{#if note}}<span>{{note}}</span>{{/if}}</figcaption>
  <div class="iv-body">
    <div class="iv-ladder"></div>
    <div class="iv-main">
      <div class="iv-seq"></div>
      <p class="iv-now" aria-live="polite"></p>
    </div>
  </div>
  <div class="rhythm-controls"></div>
</figure>
